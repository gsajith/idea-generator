# Copy to .env.local and fill in. Every variable the app reads is listed here.

# Postgres connection string (Neon in production).
DATABASE_URL=

# next-auth: generate a secret with `npx auth secret`.
AUTH_SECRET=
# Google OAuth client from Google Cloud Console. Add <app url>/api/auth/callback/google as a redirect URI.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated emails allowed to sign in. Everyone else is refused.
ALLOWED_EMAILS=

# Anthropic API key used by every model call.
ANTHROPIC_API_KEY=
# Optional: an Anthropic-compatible endpoint to send model calls to instead.
ANTHROPIC_BASE_URL=
# Optional: model IDs per role. Defaults are claude-haiku-5-5 and claude-sonnet-5-5.
# A model without a price in src/model/anthropic.ts fails at startup.
FILTER_MODEL=
REASONING_MODEL=
